<?xml version="1.0" encoding="utf-8"?>
<!-- SM-T545: tells LineageOS (lineage-sdk) that the tablet has an assist key (the "Active key", mapped to KEY_ASSISTANT in the DT),
     so Settings > System > Buttons offers press / long-press actions for it. Built by build.sh, mounted into /product/overlay by prep.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.t545.overlay.lineagesdk">
    <overlay android:targetPackage="lineageos.platform" android:isStatic="true" android:priority="1" />
    <application android:hasCode="false" />
</manifest>
