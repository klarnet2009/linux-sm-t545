# SM-T545 mainline: labels for /cache/t545 and the tmpfs overlays (appended to system_ext_file_contexts)
/cache/t545(/.*)?                                       u:object_r:t545_cache_file:s0
/cache/t545/vlib(/.*)?                                  u:object_r:same_process_hal_file:s0
/cache/t545/vlib32(/.*)?                                u:object_r:same_process_hal_file:s0
/cache/t545/vlib32/modules(/.*)?                        u:object_r:t545_module_file:s0
/cache/t545/venus(/.*)?                                 u:object_r:t545_module_file:s0
/cache/t545/lib(/.*)?                                   u:object_r:same_process_hal_file:s0
/cache/t545/c2(/.*)?                                    u:object_r:same_process_hal_file:s0
/cache/t545/c2/etc(/.*)?                                u:object_r:system_file:s0
/cache/t545/c2/media-c2-v4l2                            u:object_r:mediacodec_exec:s0
/cache/t545/bin/allocator-minigbm_msm                   u:object_r:hal_graphics_allocator_default_exec:s0
/cache/t545/bin/hwc3-drm                                u:object_r:hal_graphics_composer_default_exec:s0
/cache/t545/bin/gatekeeper-software                     u:object_r:hal_gatekeeper_default_exec:s0
/cache/t545/vbin/android\.hardware\.camera\.provider@2\.5-service_64 u:object_r:hal_camera_default_exec:s0
/cache/t545/etc(/.*)?                                   u:object_r:vendor_configs_file:s0
/cache/t545/sensors_cfg(/.*)?                           u:object_r:vendor_configs_file:s0
/cache/t545/vintf(/.*)?                                 u:object_r:vendor_configs_file:s0
/cache/t545/seccomp(/.*)?                               u:object_r:system_file:s0
/system/etc/init(/.*)?                                  u:object_r:system_file:s0
/system/etc/init/t545/keymint-service                   u:object_r:t545_keymint_exec:s0
/system/etc/init/t545/hexagonrpcd                       u:object_r:t545_hexrpcd_exec:s0
/system/etc/init/t545/rmtfs                             u:object_r:t545_qrtr_exec:s0
/system/etc/init/t545/tqftpserv                         u:object_r:t545_qrtr_exec:s0
/system/etc/init/t545/bluetooth-hal                     u:object_r:hal_bluetooth_default_exec:s0
/system/etc/init/t545/vibrator-service                  u:object_r:hal_vibrator_default_exec:s0
/system/etc/init/t545/adb_keys                          u:object_r:adb_keys_file:s0
/system/etc/init/t545/firmware-5\.bin                   u:object_r:vendor_firmware_file:s0
/system/etc/permissions(/.*)?                           u:object_r:system_file:s0
/dev/t545fw(/.*)?                                       u:object_r:vendor_firmware_file:s0
/dev/t545povl(/.*)?                                     u:object_r:system_file:s0
# DRM nodes: render nodes are the GPU for every app (Mesa freedreno), the primary node is the display (hwc3)
/dev/dri/renderD[0-9]+                                  u:object_r:gpu_device:s0
/dev/dri/card[0-9]+                                     u:object_r:graphics_device:s0
# hardware ISP (t545-icp.ko): only the camera HAL opens it
/dev/cvp-t545-isp                                       u:object_r:video_device:s0
# mainline fastrpc (hexagonrpcd -> ADSP sensors) under the stock adsprpc labels; rmtfs shared memory of the modem
/dev/fastrpc-adsp                                       u:object_r:qdsp_device:s0
/dev/fastrpc-adsp-secure                                u:object_r:xdsp_device:s0
/dev/qcom_rmtfs_mem[0-9]+                               u:object_r:t545_rmtfs_device:s0
# /dev/mem only for the boot counter reset in postboot (stage1 stub, see t545_manual.cil)
/dev/mem                                                u:object_r:t545_mem_device:s0
/system/etc/init/t545/light-service                     u:object_r:hal_light_default_exec:s0
# boot time: phh's rw-system.sh without its /sys-wide find (initramfs init), same label as /system/bin/rw-system.sh
/system/etc/init/t545/rw-system\.sh                     u:object_r:phhsu_exec:s0
