<!-- SM-T545: Codec2 IComponentStore/default1 = t545_media_c2 (fork of external/v4l2_codec2, system binary in /cache/t545/c2) on the
     mainline Venus V4L2 nodes. Not "default": the 32-bit Samsung media.codec (vendor.media.omx) registers "default" as well and wins
     whenever that name is declared (its store broke every CCodec on 19.10), and CCodec makes "default" the preferred store of all codecs.
     "default1" matches the FCM regex default[0-9]* and Codec2Client lists it before "software". -->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.media.c2</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IComponentStore</name>
            <instance>default1</instance>
        </interface>
        <fqname>@1.2::IComponentStore/default1</fqname>
    </hal>
</manifest>
