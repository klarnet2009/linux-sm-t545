From 8b205ac47198ebaaa9c50819fb8e91af643720e2 Mon Sep 17 00:00:00 2001
From: klarnet2009 <185848556+klarnet2009@users.noreply.github.com>
Date: Wed, 28 Oct 2026 10:17:52 +0200
Subject: [PATCH 06/14] reboot: redirect restarts to Download mode for bring-up
 images

With the t545 download timer active, any restart command other than download is replaced by download, so the console of a dead boot survives in ramoops.
---
 kernel/reboot.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/kernel/reboot.c b/kernel/reboot.c
index ec087827c..d0ad6ba25 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -284,8 +284,15 @@ static void do_kernel_restart_prepare(void)
  *	Shutdown everything and perform a clean reboot.
  *	This is not safe to call in interrupt context.
  */
+extern bool t545_dl_active;
+
 void kernel_restart(char *cmd)
 {
+	/* bring-up: a test image never reboots into anything but Download mode, so that the dead boot's console survives */
+	if (t545_dl_active && (!cmd || strcmp(cmd, "download"))) {
+		pr_emerg("t545: restart with command '%s' redirected to download\n", cmd ? cmd : "(null)");
+		cmd = "download";
+	}
 	kernel_restart_prepare(cmd);
 	do_kernel_restart_prepare();
 	migrate_to_reboot_cpu();
-- 
