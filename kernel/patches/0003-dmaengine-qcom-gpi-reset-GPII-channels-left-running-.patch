From a059138692e8c080f7fc227a7d4b1c2b716863df Mon Sep 17 00:00:00 2001
From: klarnet2009 <185848556+klarnet2009@users.noreply.github.com>
Date: Wed, 28 Oct 2026 10:17:51 +0200
Subject: [PATCH 03/14] dmaengine: qcom: gpi: reset GPII channels left running
 by the previous kernel

After a kexec from Android the GPII channels are still running and EV ALLOCATE never completes. Reset the stale state in probe.
---
 drivers/dma/qcom/gpi.c | 84 +++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 83 insertions(+), 1 deletion(-)

diff --git a/drivers/dma/qcom/gpi.c b/drivers/dma/qcom/gpi.c
index 6e30f3aa4..3a6bec7ed 100644
--- a/drivers/dma/qcom/gpi.c
+++ b/drivers/dma/qcom/gpi.c
@@ -5,6 +5,7 @@
  */
 
 #include <dt-bindings/dma/qcom-gpi.h>
+#include <linux/delay.h>
 #include <linux/bitfield.h>
 #include <linux/dma-mapping.h>
 #include <linux/dmaengine.h>
@@ -695,9 +696,39 @@ static int gpi_send_cmd(struct gpii *gpii, struct gchan *gchan,
 	timeout = wait_for_completion_timeout(&gpii->cmd_completion,
 					      msecs_to_jiffies(CMD_TIMEOUT_MS));
 	if (!timeout) {
+		bool pend = false, act = false, msk = false;
+
+		irq_get_irqchip_state(gpii->irq, IRQCHIP_STATE_PENDING, &pend);
+		irq_get_irqchip_state(gpii->irq, IRQCHIP_STATE_ACTIVE, &act);
+		irq_get_irqchip_state(gpii->irq, IRQCHIP_STATE_MASKED, &msk);
 		dev_err(gpii->gpi_dev->dev, "cmd: %s completion timeout:%u\n",
 			TO_GPI_CMD_STR(gpi_cmd), chid);
-		return -EIO;
+		dev_err(gpii->gpi_dev->dev, "t545dbg gpii%u irq%d pend=%d act=%d msk=%d type=%08x tmsk=%08x glob=%08x globen=%08x gpiien=%08x evsrc=%08x evmsk=%08x evctx=%08x err=%08x\n",
+			gpii->gpii_id, gpii->irq, pend, act, msk,
+			readl_relaxed(gpii->regs + GPII_n_CNTXT_TYPE_IRQ_OFFS(gpii->gpii_id)),
+			readl_relaxed(gpii->regs + GPII_n_CNTXT_TYPE_IRQ_MSK_OFFS(gpii->gpii_id)),
+			readl_relaxed(gpii->regs + GPII_n_CNTXT_GLOB_IRQ_STTS_OFFS(gpii->gpii_id)),
+			readl_relaxed(gpii->regs + GPII_n_CNTXT_GLOB_IRQ_EN_OFFS(gpii->gpii_id)),
+			readl_relaxed(gpii->regs + GPII_n_CNTXT_GPII_IRQ_EN_OFFS(gpii->gpii_id)),
+			readl_relaxed(gpii->regs + GPII_n_CNTXT_SRC_EV_CH_IRQ_OFFS(gpii->gpii_id)),
+			readl_relaxed(gpii->regs + GPII_n_CNTXT_SRC_EV_CH_IRQ_MSK_OFFS(gpii->gpii_id)),
+			readl_relaxed(gpii->ev_cntxt_base_reg + CNTXT_0_CONFIG),
+			readl_relaxed(gpii->regs + GPII_n_ERROR_LOG_OFFS(gpii->gpii_id)));
+		/* t545: no completion IRQ - take the state from the context register */
+		if (IS_CHAN_CMD(gpi_cmd)) {
+			u32 v = readl_relaxed(gchan->ch_cntxt_base_reg + CNTXT_0_CONFIG);
+
+			gchan->ch_state = gpi_cmd == GPI_CH_CMD_DE_ALLOC ? DEFAULT_CH_STATE :
+					  FIELD_GET(GPII_n_CH_k_CNTXT_0_CHSTATE, v);
+		} else {
+			u32 v = readl_relaxed(gpii->ev_cntxt_base_reg + CNTXT_0_CONFIG);
+
+			gpii->ev_state = FIELD_GET(GPII_n_EV_k_CNTXT_0_CHSTATE, v);
+		}
+		writel_relaxed(U32_MAX, gpii->regs + GPII_n_CNTXT_SRC_CH_IRQ_CLR_OFFS(gpii->gpii_id));
+		writel_relaxed(U32_MAX, gpii->regs + GPII_n_CNTXT_SRC_EV_CH_IRQ_CLR_OFFS(gpii->gpii_id));
+		dev_info(gpii->gpi_dev->dev, "t545dbg polled state after %s: ch=%d ev=%d\n",
+			 TO_GPI_CMD_STR(gpi_cmd), gchan ? gchan->ch_state : -1, gpii->ev_state);
 	}
 
 	/* confirm new ch state is correct , if the cmd is a state change cmd */
@@ -827,6 +858,8 @@ static irqreturn_t gpi_handle_irq(int irq, void *data)
 	u32 type, offset;
 	unsigned long flags;
 
+	dev_info(gpii->gpi_dev->dev, "t545dbg irq %d gpii%u pm_state %d\n", irq, gpii_id, gpii->pm_state);
+
 	read_lock_irqsave(&gpii->pm_lock, flags);
 
 	/*
@@ -2158,6 +2191,54 @@ static struct dma_chan *gpi_of_dma_xlate(struct of_phandle_args *args,
 	return dma_get_slave_channel(&gchan->vc.chan);
 }
 
+/* t545: stale state left by the previous kernel (kexec) - stop, reset and free the channels and the event ring */
+static void gpi_t545_reset_stale(struct gpii *gpii)
+{
+	u32 ev = readl_relaxed(gpii->ev_cntxt_base_reg + CNTXT_0_CONFIG);
+	u32 st[MAX_CHANNELS_PER_GPII];
+	int k;
+	bool stale = FIELD_GET(GPII_n_EV_k_CNTXT_0_CHSTATE, ev);
+
+	for (k = 0; k < MAX_CHANNELS_PER_GPII; k++) {
+		st[k] = FIELD_GET(GPII_n_CH_k_CNTXT_0_CHSTATE,
+				  readl_relaxed(gpii->gchan[k].ch_cntxt_base_reg + CNTXT_0_CONFIG));
+		stale |= !!st[k];
+	}
+	if (!stale)
+		return;
+
+	dev_info(gpii->gpi_dev->dev, "t545 gpii%u stale state ev=%u ch0=%u ch1=%u, resetting\n",
+		 gpii->gpii_id, (unsigned int)FIELD_GET(GPII_n_EV_k_CNTXT_0_CHSTATE, ev), st[0], st[1]);
+
+	for (k = 0; k < MAX_CHANNELS_PER_GPII; k++) {
+		void __iomem *cmd = gpii->gchan[k].ch_cmd_reg;
+
+		writel_relaxed(GPII_n_CH_CMD(GPII_n_CH_CMD_STOP, k), cmd);
+		mdelay(10);
+		writel_relaxed(GPII_n_CH_CMD(GPII_n_CH_CMD_RESET, k), cmd);
+		mdelay(10);
+		writel_relaxed(GPII_n_CH_CMD(GPII_n_CH_CMD_DE_ALLOC, k), cmd);
+		mdelay(10);
+	}
+	writel_relaxed(GPII_n_EV_CMD(GPII_n_EV_CH_CMD_RESET, 0), gpii->ev_cmd_reg);
+	mdelay(10);
+	writel_relaxed(GPII_n_EV_CMD(GPII_n_EV_CH_CMD_DE_ALLOC, 0), gpii->ev_cmd_reg);
+	mdelay(10);
+
+	ev = readl_relaxed(gpii->ev_cntxt_base_reg + CNTXT_0_CONFIG);
+	dev_info(gpii->gpi_dev->dev, "t545 gpii%u after reset: ev=%u ch0=%u ch1=%u\n", gpii->gpii_id,
+		 (unsigned int)FIELD_GET(GPII_n_EV_k_CNTXT_0_CHSTATE, ev),
+		 (unsigned int)FIELD_GET(GPII_n_CH_k_CNTXT_0_CHSTATE,
+					 readl_relaxed(gpii->gchan[0].ch_cntxt_base_reg + CNTXT_0_CONFIG)),
+		 (unsigned int)FIELD_GET(GPII_n_CH_k_CNTXT_0_CHSTATE,
+					 readl_relaxed(gpii->gchan[1].ch_cntxt_base_reg + CNTXT_0_CONFIG)));
+
+	/* drop whatever the old kernel left pending */
+	writel_relaxed(U32_MAX, gpii->regs + GPII_n_CNTXT_SRC_CH_IRQ_CLR_OFFS(gpii->gpii_id));
+	writel_relaxed(U32_MAX, gpii->regs + GPII_n_CNTXT_SRC_EV_CH_IRQ_CLR_OFFS(gpii->gpii_id));
+	writel_relaxed(U32_MAX, gpii->regs + GPII_n_CNTXT_GLOB_IRQ_CLR_OFFS(gpii->gpii_id));
+}
+
 static int gpi_probe(struct platform_device *pdev)
 {
 	struct gpi_dev *gpi_dev;
@@ -2253,6 +2334,7 @@ static int gpi_probe(struct platform_device *pdev)
 		gpii->gpii_id = i;
 		gpii->regs = gpi_dev->ee_base;
 		gpii->gpi_dev = gpi_dev;
+		gpi_t545_reset_stale(gpii);
 	}
 
 	platform_set_drvdata(pdev, gpi_dev);
-- 
2.47.3

