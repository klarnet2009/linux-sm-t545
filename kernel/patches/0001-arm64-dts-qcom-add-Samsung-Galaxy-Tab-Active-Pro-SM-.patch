diff --git a/arch/arm64/boot/dts/qcom/t545-emmc.dtsi b/arch/arm64/boot/dts/qcom/t545-emmc.dtsi
new file mode 100644
index 000000000..535090b89
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/t545-emmc.dtsi
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * eMMC (sdhci@7c4000, the "bootdevice" of Samsung's kernel): rails taken from the live DT of the running stock kernel,
+ * vdd-supply = pm660l L4 (2.96 V), vdd-io-supply = pm660 L8 (1.8 V). The pad configuration (TLMM sdc1 pins) was left by
+ * the bootloader; the TLMM driver is not used yet.
+ */
+
+&apps_rsc {
+	regulators-0 {
+		vreg_l8a_1p8: ldo8 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-enable-ramp-delay = <250>;
+		};
+	};
+
+	regulators-1 {
+		vreg_l4b_2p95: ldo4 {
+			regulator-min-microvolt = <2944000>;
+			regulator-max-microvolt = <2960000>;
+			regulator-enable-ramp-delay = <250>;
+		};
+	};
+};
+
+&sdhc_1 {
+	/delete-property/ pinctrl-names;
+	/delete-property/ pinctrl-0;
+	/delete-property/ pinctrl-1;
+
+	/* the bootloader leaves SDCC1 in a state where the HC regs ignore writes until GCC_SDCC1_BCR is pulsed */
+	resets = <&gcc GCC_SDCC1_BCR>;
+
+	vmmc-supply = <&vreg_l4b_2p95>;
+	vqmmc-supply = <&vreg_l8a_1p8>;
+
+	mmc-ddr-1_8v;
+	mmc-hs200-1_8v;
+	mmc-hs400-1_8v;
+};
diff --git a/arch/arm64/boot/dts/qcom/t545-gcc-protected.dtsi b/arch/arm64/boot/dts/qcom/t545-gcc-protected.dtsi
new file mode 100644
index 000000000..8721fe2b4
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/t545-gcc-protected.dtsi
@@ -0,0 +1,10 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* found by the stub's group search on the SM-T545: GCC_QSPI_CORE_CLK_SRC hangs the SoC when read; the QSPI/LPASS
+ * clocks around it are owned by TrustZone/other subsystems on every SDM845-family board */
+&gcc {
+	protected-clocks = <GCC_QSPI_CORE_CLK>,
+			   <GCC_QSPI_CORE_CLK_SRC>,
+			   <GCC_QSPI_CNOC_PERIPH_AHB_CLK>,
+			   <GCC_LPASS_Q6_AXI_CLK>,
+			   <GCC_LPASS_SWAY_CLK>;
+};
diff --git a/arch/arm64/boot/dts/qcom/t545-headset.dtsi b/arch/arm64/boot/dts/qcom/t545-headset.dtsi
new file mode 100644
index 000000000..4beac0122
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/t545-headset.dtsi
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SM-T545 3.5 mm headset jack: headphones (HPHL/HPHR) and headset microphone (AMIC2).
+ *
+ * Playback: MultiMedia1 -> q6routing INT0_MI2S_RX -> AFE port 0x102e (INT0 MI2S RX, SD0+SD1) -> LPASS digital codec RX1/RX2
+ *           -> PDM over LPI gpio18 clk / gpio19 sync / gpio21 rx0 / gpio23 rx1 / gpio25 rx2 -> PM660L HPHL/HPHR (stock mi2s dev-id 7).
+ * Capture:  AMIC2 (MIC BIAS 2, external type with ext cap) goes through the mic path of t545-mic.dtsi (ADC2 -> DEC1 -> INT3_MI2S_TX).
+ * Plug detection: the PM660L MBHC by default. The stock kernel does not use it (it has a TLMM plug switch, gpio125 active low, and a
+ * media key, gpio116 active low, read by Samsung sec_jack): if MBHC does not see the plug, enable the two earjack-*-gpios lines below.
+ * LPI pins are set by sdm845.c once the INT0 bit clock powers LPASS, never at boot.
+ * Include after t545-mic.dtsi (it replaces that file's sound audio-routing, so the microphone entries are repeated).
+ */
+
+&tlmm {
+	earjack_default: earjack-default-state {
+		pins = "gpio116", "gpio125";
+		function = "gpio";
+		bias-disable;
+		drive-strength = <2>;
+		input-enable;
+	};
+};
+
+&pm660l_codec {
+	/* MBHC button thresholds in mV (apq8016 reference values, the stock kernel has no MBHC to take them from); needs a calibration run */
+	qcom,mbhc-vthreshold-low = <75 150 237 450 500>;
+	qcom,mbhc-vthreshold-high = <75 150 237 450 500>;
+};
+
+&q6afedai {
+	dai@95 {
+		reg = <INT0_MI2S_RX>;
+		/* stock qcom,msm-mi2s-rx-lines = 3; two channels go on SD0 */
+		qcom,sd-lines = <0 1>;
+	};
+};
+
+/ {
+	sound {
+		pinctrl-0 = <&earjack_default>;
+		pinctrl-names = "default";
+
+		/* plug switch / media key instead of the MBHC (see above); both active low */
+		earjack-det-gpios = <&tlmm 125 GPIO_ACTIVE_LOW>;
+		earjack-key-gpios = <&tlmm 116 GPIO_ACTIVE_LOW>;
+
+		audio-routing = "Analog AMIC1", "Analog MIC BIAS External1",
+				"Analog AMIC3", "Analog MIC BIAS External1",
+				"Analog AMIC2", "Analog MIC BIAS External2",
+				"Analog AMIC2", "Headset Mic",
+				"Headphone Jack", "Analog HPH_L",
+				"Headphone Jack", "Analog HPH_R";
+
+		headset-dai-link {
+			link-name = "Headset";
+
+			cpu {
+				sound-dai = <&q6afedai INT0_MI2S_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&lpass_codec 0>, <&pm660l_codec 0>;
+			};
+		};
+	};
+};
