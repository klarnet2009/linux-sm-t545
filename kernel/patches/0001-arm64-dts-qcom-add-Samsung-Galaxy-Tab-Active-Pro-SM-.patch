diff --git a/arch/arm64/boot/dts/qcom/t545-misc.dtsi b/arch/arm64/boot/dts/qcom/t545-misc.dtsi
new file mode 100644
index 000000000..120b29f9f
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/t545-misc.dtsi
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SM-T545 small peripherals: vibration motor (coin DC motor on pm660l L8, stock "msm_vibrator") and the camera flash LED
+ * (SM5705 FLED: torch-gpios/flash-gpios on the charger node, driven by sm5705-chg-t545.c).
+ */
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+
+&apps_rsc {
+	regulators-1 {
+		vreg_l8b_3p3: ldo8 {
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3312000>;
+			/* stock msm_vibrator: regulator_set_load(100 mA) before enabling, i.e. the LDO runs in HPM (it init-moded LPM otherwise) */
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;
+			regulator-allow-set-load;
+			regulator-enable-ramp-delay = <250>;
+		};
+	};
+};
+
+/ {
+	vibrator {
+		compatible = "samsung,t545-vibrator";
+		vibr-supply = <&vreg_l8b_3p3>;
+	};
+
+};
diff --git a/arch/arm64/boot/dts/qcom/t545-otg.dtsi b/arch/arm64/boot/dts/qcom/t545-otg.dtsi
new file mode 100644
index 000000000..ef277b070
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/t545-otg.dtsi
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * USB OTG (host) on the Type-C port. Include after t545-usb.dtsi (it overrides dr_mode).
+ * - S2MM005 (stock usbpd-s2mm005@33: usbpd_int = gpio38, pinctrl ccic_irq_default = gpio, bias-disable) reports the attach;
+ * - VBUS = SM5705 boost in USB_OTG mode (stock: usb_notifier_qcom.c otg_accessory_power -> psy "otg"); the stock
+ *   vbus_dwc3-supply = PM660 "smb2-vbus" is dead there (CONFIG_QPNP_SMB2 is not set), so it is not used here;
+ * - DWC3 role switch: host while the partner is a sink, peripheral (default, adb) otherwise.
+ */
+
+&pdic {
+	interrupts-extended = <&tlmm 38 IRQ_TYPE_EDGE_FALLING>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pdic_irq_default>;
+
+	connector {
+		compatible = "usb-c-connector";
+		label = "USB-C";
+		data-role = "dual";
+		power-role = "dual";
+		try-power-role = "sink";
+		vbus-supply = <&otg_vbus>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				pdic_hs_ep: endpoint {
+					remote-endpoint = <&usb_1_dwc3_hs_ep>;
+				};
+			};
+		};
+	};
+};
+
+&i2c_chg {
+	charger@49 {
+		otg_vbus: usb-otg-vbus {
+			regulator-name = "usb_otg_vbus";
+		};
+	};
+};
+
+&tlmm {
+	pdic_irq_default: pdic-irq-default-state {
+		pins = "gpio38";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
+
+&usb_1_dwc3 {
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+
+	port {
+		usb_1_dwc3_hs_ep: endpoint {
+			remote-endpoint = <&pdic_hs_ep>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/t545-usb.dtsi b/arch/arm64/boot/dts/qcom/t545-usb.dtsi
new file mode 100644
index 000000000..47f4a74fe
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/t545-usb.dtsi
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* USB 2.0 gadget (serial console) bring-up: the rails the stock Samsung DT lists for qusb@88e2000 */
+
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm660-rpmh-regulators";
+		qcom,pmic-id = "a";
+
+		vreg_l10a_1p8: ldo10 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-enable-ramp-delay = <250>;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,pm660l-rpmh-regulators";
+		qcom,pmic-id = "b";
+
+		vreg_l1b_0p925: ldo1 {
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <900000>;
+			regulator-enable-ramp-delay = <250>;
+		};
+
+		vreg_l7b_3p125: ldo7 {
+			regulator-min-microvolt = <3088000>;
+			regulator-max-microvolt = <3100000>;
+			regulator-enable-ramp-delay = <250>;
+		};
+	};
+};
+
+&usb_1_hsphy {
+	vdd-supply = <&vreg_l1b_0p925>;
+	vdda-pll-supply = <&vreg_l10a_1p8>;
+	vdda-phy-dpdm-supply = <&vreg_l7b_3p125>;
+};
+
+&usb_1 {
+	qcom,select-utmi-as-pipe-clk;
+};
+
+&usb_1_dwc3 {
+	dr_mode = "peripheral";
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
+	maximum-speed = "high-speed";
+};
diff --git a/arch/arm64/boot/dts/qcom/t545-venus.dtsi b/arch/arm64/boot/dts/qcom/t545-venus.dtsi
new file mode 100644
index 000000000..db9efe9bb
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/t545-venus.dtsi
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SM-T545 (SDM670): Venus video codec (/dev/video* stateful decoder + encoder).
+ * Stock numbers (dt0.dts qcom,vidc0, qcom,venus@aae0000, pil_video_region) all agree with the mainline sdm670.dtsi node:
+ * reg 0xaa00000, SMMU SIDs 0x10a0/0x8 + 0x10b0, PAS id 9, memory-region 0x92e00000 + 0x500000, videocc clock/GDSC indexes.
+ *
+ * status is NOT set here: t545-disable.dtsi keeps "disabled" and the stage1 stub flips it with group "video" (groups.py, bit 13),
+ * which enables clock-controller@ab00000 and video-codec@aa00000 together. A boot without the stub needs status = "okay" on
+ * &videocc and &venus.
+ */
+
+&venus {
+	/* sdm670 resources (cp_size/cp_nonpixel_size from the stock DT); falls back to the sdm845 v2 table on a kernel without the patch */
+	compatible = "qcom,sdm670-venus", "qcom,sdm845-venus-v2";
+
+	/*
+	 * Samsung-signed image (venus.mdt + venus.b00..b04, PAS id 9) from the modem partition. firmware_class.path is /dev/t545fw, so
+	 * the init script links /vendor/firmware_mnt/image/venus.* there before the driver binds (see Venus boot flow in the report).
+	 */
+	firmware-name = "venus.mdt";
+};
