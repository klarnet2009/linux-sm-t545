diff --git a/arch/arm64/boot/dts/qcom/t545-mic.dtsi b/arch/arm64/boot/dts/qcom/t545-mic.dtsi
new file mode 100644
index 000000000..89edb285a
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/t545-mic.dtsi
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SM-T545 built-in microphones (stock live.dts "sound" + mixer_paths.xml main-mic/sub-mic):
+ *   AMIC1 (handset/main) / AMIC3 (secondary), MIC BIAS 1 external with ext cap, 2.8 V
+ *   -> PM660L analog codec (SPMI usid 3, 0xf000) -> PDM over LPASS LPI gpio18 clk / gpio19 sync / gpio20 tx
+ *   -> LPASS digital codec (0x62ec0000) DEC1 (and DEC2 for stereo) -> I2S TX -> INT3 MI2S TX (AFE port 0x1035, SD0+SD1)
+ *   -> q6routing -> MultiMedia2.
+ * Codec MCLK = AFE INT_MCLK_0 at 9.6 MHz, switched by the digital codec only while capturing; the LPI pins and the INT3
+ * bit clock are set by sdm845.c (INT3_MI2S_TX startup). No LPASS MMIO is touched at boot.
+ * Include at the end of sdm670-samsung-gtactivexl.dts (after t545-usb.dtsi, which defines the three rails).
+ */
+
+&spmi_bus {
+	pmic@3 {
+		compatible = "qcom,pm660l", "qcom,spmi-pmic";
+		reg = <0x3 SPMI_USID>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		pm660l_codec: audio-codec@f000 {
+			compatible = "qcom,pm660l-wcd-analog-codec",
+				     "qcom,pm8916-wcd-analog-codec";
+			reg = <0xf000>;
+			interrupts = <0x3 0xf0 0x0 IRQ_TYPE_NONE>,
+				     <0x3 0xf0 0x1 IRQ_TYPE_NONE>,
+				     <0x3 0xf0 0x2 IRQ_TYPE_NONE>,
+				     <0x3 0xf0 0x3 IRQ_TYPE_NONE>,
+				     <0x3 0xf0 0x4 IRQ_TYPE_NONE>,
+				     <0x3 0xf0 0x5 IRQ_TYPE_NONE>,
+				     <0x3 0xf0 0x6 IRQ_TYPE_NONE>,
+				     <0x3 0xf0 0x7 IRQ_TYPE_NONE>,
+				     <0x3 0xf1 0x0 IRQ_TYPE_NONE>,
+				     <0x3 0xf1 0x1 IRQ_TYPE_NONE>,
+				     <0x3 0xf1 0x2 IRQ_TYPE_NONE>,
+				     <0x3 0xf1 0x3 IRQ_TYPE_NONE>,
+				     <0x3 0xf1 0x4 IRQ_TYPE_NONE>,
+				     <0x3 0xf1 0x5 IRQ_TYPE_NONE>;
+			interrupt-names = "cdc_spk_cnp_int",
+					  "cdc_spk_clip_int",
+					  "cdc_spk_ocp_int",
+					  "mbhc_ins_rem_det1",
+					  "mbhc_but_rel_det",
+					  "mbhc_but_press_det",
+					  "mbhc_ins_rem_det",
+					  "mbhc_switch_int",
+					  "cdc_ear_ocp_int",
+					  "cdc_hphr_ocp_int",
+					  "cdc_hphl_ocp_det",
+					  "cdc_ear_cnp_int",
+					  "cdc_hphr_cnp_int",
+					  "cdc_hphl_cnp_int";
+
+			/* stock cdc-vdda18-l10 (pm660 L10 1.8 V), cdc-vdd-l1 (pm660l L1 0.88 V), cdc-vdd-mic-bias (pm660l L7 3.088 V) */
+			vdd-cdc-io-supply = <&vreg_l10a_1p8>;
+			vdd-cdc-tx-rx-cx-supply = <&vreg_l1b_0p925>;
+			vdd-micbias-supply = <&vreg_l7b_3p125>;
+
+			qcom,micbias1-ext-cap;		/* stock qcom,msm-micbias1-ext-cap */
+			qcom,micbias2-ext-cap;		/* stock qcom,msm-micbias2-ext-cap */
+			qcom,micbias-lvl = <2800>;	/* stock qcom,cdc-micbias-cfilt-mv = 2800000 */
+			qcom,hphl-jack-type-normally-open;	/* stock qcom,msm-mbhc-hphl-swh = 1 */
+			qcom,gnd-jack-type-normally-open;	/* stock qcom,msm-mbhc-gnd-swh = 1 */
+
+			sound-name-prefix = "Analog";
+			#sound-dai-cells = <1>;
+		};
+	};
+};
+
+&lpass_codec {
+	/* stock qcom,msm-mclk-freq = 9600000; q6afe-clocks would default INT_MCLK_0 to 19.2 MHz */
+	assigned-clocks = <&q6afecc LPASS_CLK_ID_INT_MCLK_0 LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+	assigned-clock-rates = <9600000>;
+	status = "okay";
+};
+
+&q6asmdai {
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+	};
+};
+
+&q6afedai {
+	dai@9c {
+		reg = <INT3_MI2S_TX>;
+		/* stock qcom,msm-dai-q6-int-mi2s3: dev-id 10, msm-mi2s-tx-lines = 3 (SD0 + SD1); up to 2 channels go on SD0 */
+		qcom,sd-lines = <0 1>;
+	};
+};
+
+/ {
+	sound {
+		audio-routing = "Analog AMIC1", "Analog MIC BIAS External1",
