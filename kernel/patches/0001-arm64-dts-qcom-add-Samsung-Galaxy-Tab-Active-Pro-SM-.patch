+&{/soc@0/interconnect@1380000} { status = "disabled"; };
+&{/soc@0/interconnect@14e0000} { status = "disabled"; };
+&{/soc@0/interconnect@1500000} { status = "disabled"; };
+&{/soc@0/interconnect@1620000} { status = "disabled"; };
+&{/soc@0/interconnect@16e0000} { status = "disabled"; };
+&{/soc@0/interconnect@1700000} { status = "disabled"; };
+&{/soc@0/interconnect@1740000} { status = "disabled"; };
+&{/soc@0/ipa@1e40000} { status = "disabled"; };
+&{/soc@0/hwlock@1f40000} { status = "disabled"; };
+&{/soc@0/syscon@1f60000} { status = "disabled"; };
+&{/soc@0/pinctrl@3400000} { status = "disabled"; };
+&{/soc@0/remoteproc@4080000} { status = "disabled"; };
