diff --git a/sound/soc/codecs/msm8916-wcd-digital.c b/sound/soc/codecs/msm8916-wcd-digital.c
index cfadea2aa..ae31b5648 100644
--- a/sound/soc/codecs/msm8916-wcd-digital.c
+++ b/sound/soc/codecs/msm8916-wcd-digital.c
@@ -226,6 +226,27 @@ struct wcd_iir_filter_ctl {
 
 struct msm8916_wcd_digital_priv {
 	struct clk *ahbclk, *mclk;
+	struct regmap *map;
+	/*
+	 * SDM660/SDM670: the codec sits in the ADSP-owned LPASS, mclk is the AFE INT_MCLK_0 clock and the registers only
+	 * answer while it runs, so the regmap stays cache-only and mclk is switched with the "MCLK" DAPM supply.
+	 */
+	bool mclk_on_demand;
+};
+
+/* SDM660 POR values (vendor sdm660-cdc-registers.h) of the registers this driver uses that do not reset to 0 */
+static const struct reg_default sdm660_nonzero_por[] = {
+	{ LPASS_CDC_CLK_RX_I2S_CTL, 0x13 },
+	{ LPASS_CDC_CLK_TX_I2S_CTL, 0x13 },
+	{ LPASS_CDC_CLK_OTHR_CTL, 0x04 },
+	{ LPASS_CDC_RX1_B5_CTL, 0x68 },
+	{ LPASS_CDC_RX2_B5_CTL, 0x68 },
+	{ LPASS_CDC_RX3_B5_CTL, 0x68 },
+	{ LPASS_CDC_TOP_CTL, 0x01 },
+	{ LPASS_CDC_IIR1_CTL, 0x40 },
+	{ LPASS_CDC_IIR2_CTL, 0x40 },
+	{ LPASS_CDC_TX1_CLK_FS_CTL, 0x03 },
+	{ LPASS_CDC_TX2_CLK_FS_CTL, 0x03 },
 };
 
 static const unsigned long rx_gain_reg[] = {
@@ -700,6 +721,35 @@ static int msm8916_wcd_digital_enable_dmic(struct snd_soc_dapm_widget *w,
 	return 0;
 }
 
+static int msm8916_wcd_digital_enable_mclk(struct snd_soc_dapm_widget *w,
+					   struct snd_kcontrol *kcontrol,
+					   int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct msm8916_wcd_digital_priv *priv = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	if (!priv->mclk_on_demand)
+		return 0;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		ret = clk_prepare_enable(priv->mclk);
+		if (ret)
+			return ret;
+		regcache_cache_only(priv->map, false);
+		/* shortcut: only non-POR values are synced; if LPASS keeps state, a register reset to POR while idle is missed */
+		regcache_mark_dirty(priv->map);
+		return regcache_sync(priv->map);
+	case SND_SOC_DAPM_POST_PMD:
+		regcache_cache_only(priv->map, true);
+		clk_disable_unprepare(priv->mclk);
+		break;
+	}
+
+	return 0;
+}
+
 static const char * const iir_inp1_text[] = {
 	"ZERO", "DEC1", "DEC2", "RX1", "RX2", "RX3"
 };
@@ -800,7 +850,10 @@ static const struct snd_soc_dapm_widget msm8916_wcd_digital_dapm_widgets[] = {
 	SND_SOC_DAPM_SUPPLY("TX_I2S_CLK", LPASS_CDC_CLK_TX_I2S_CTL, 4, 0,
 			    NULL, 0),
 
-	SND_SOC_DAPM_SUPPLY("MCLK", SND_SOC_NOPM, 0, 0, NULL, 0),
+	/* first supply up, last down: every register write of the other widgets needs it on SDM660 */
+	SND_SOC_DAPM_SUPPLY_S("MCLK", -3, SND_SOC_NOPM, 0, 0,
+			      msm8916_wcd_digital_enable_mclk,
+			      SND_SOC_DAPM_PRE_PMU | SND_SOC_DAPM_POST_PMD),
 	SND_SOC_DAPM_SUPPLY("PDM_CLK", LPASS_CDC_CLK_PDM_CTL, 0, 0, NULL, 0),
 	/* Connectivity Clock */
 	SND_SOC_DAPM_SUPPLY_S("CDC_CONN", -2, LPASS_CDC_CLK_OTHR_CTL, 2, 0,
@@ -824,7 +877,8 @@ static int msm8916_wcd_digital_get_clks(struct platform_device *pdev,
 {
 	struct device *dev = &pdev->dev;
 
-	priv->ahbclk = devm_clk_get(dev, "ahbix-clk");
+	/* SDM660/SDM670 have no AHB clock under Linux control */
+	priv->ahbclk = devm_clk_get_optional(dev, "ahbix-clk");
 	if (IS_ERR(priv->ahbclk)) {
 		dev_err(dev, "failed to get ahbix clk\n");
 		return PTR_ERR(priv->ahbclk);
@@ -1165,6 +1219,7 @@ static const struct regmap_config msm8916_codec_regmap_config = {
 
 static int msm8916_wcd_digital_probe(struct platform_device *pdev)
 {
+	struct regmap_config cfg = msm8916_codec_regmap_config;
 	struct msm8916_wcd_digital_priv *priv;
 	struct device *dev = &pdev->dev;
 	void __iomem *base;
@@ -1179,11 +1234,26 @@ static int msm8916_wcd_digital_probe(struct platform_device *pdev)
 	if (IS_ERR(base))
 		return PTR_ERR(base);
 
-	digital_map =
-	    devm_regmap_init_mmio(&pdev->dev, base,
-				  &msm8916_codec_regmap_config);
+	priv->mclk_on_demand = of_device_is_compatible(dev->of_node, "qcom,sdm660-wcd-digital-codec");
+	if (priv->mclk_on_demand) {
+		/* the cache must hold every register from the start: nothing can be read back before mclk runs */
+		unsigned int i, n = cfg.max_register / cfg.reg_stride + 1;
+		struct reg_default *def = devm_kcalloc(dev, n, sizeof(*def), GFP_KERNEL);
+
+		if (!def)
+			return -ENOMEM;
+		for (i = 0; i < n; i++)
+			def[i].reg = i * cfg.reg_stride;
+		for (i = 0; i < ARRAY_SIZE(sdm660_nonzero_por); i++)
+			def[sdm660_nonzero_por[i].reg / cfg.reg_stride].def = sdm660_nonzero_por[i].def;
+		cfg.reg_defaults = def;
+		cfg.num_reg_defaults = n;
+	}
+
+	digital_map = devm_regmap_init_mmio(&pdev->dev, base, &cfg);
 	if (IS_ERR(digital_map))
 		return PTR_ERR(digital_map);
+	priv->map = digital_map;
 
 	ret = msm8916_wcd_digital_get_clks(pdev, priv);
 	if (ret < 0)
@@ -1195,7 +1265,10 @@ static int msm8916_wcd_digital_probe(struct platform_device *pdev)
 		return ret;
 	}
 
-	ret = clk_prepare_enable(priv->mclk);
+	if (priv->mclk_on_demand)
+		regcache_cache_only(digital_map, true);
+	else
+		ret = clk_prepare_enable(priv->mclk);
 	if (ret < 0) {
 		dev_err(dev, "failed to enable mclk %d\n", ret);
 		goto err_clk;
@@ -1212,7 +1285,8 @@ static int msm8916_wcd_digital_probe(struct platform_device *pdev)
 	return 0;
 
 err_mclk:
-	clk_disable_unprepare(priv->mclk);
+	if (!priv->mclk_on_demand)
+		clk_disable_unprepare(priv->mclk);
 err_clk:
 	clk_disable_unprepare(priv->ahbclk);
 	return ret;
@@ -1222,7 +1296,8 @@ static void msm8916_wcd_digital_remove(struct platform_device *pdev)
 {
 	struct msm8916_wcd_digital_priv *priv = dev_get_drvdata(&pdev->dev);
 
-	clk_disable_unprepare(priv->mclk);
+	if (!priv->mclk_on_demand)
+		clk_disable_unprepare(priv->mclk);
 	clk_disable_unprepare(priv->ahbclk);
 }
 
diff --git a/sound/soc/qcom/sdm845.c b/sound/soc/qcom/sdm845.c
index 0ce9dff4d..6e830324d 100644
--- a/sound/soc/qcom/sdm845.c
+++ b/sound/soc/qcom/sdm845.c
@@ -4,6 +4,8 @@
  */
 
 #include <dt-bindings/sound/qcom,q6afe.h>
+#include <linux/gpio/consumer.h>
+#include <linux/io.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <sound/core.h>
@@ -40,8 +42,32 @@ struct sdm845_snd_data {
 	uint32_t pri_mi2s_clk_count;
 	uint32_t sec_mi2s_clk_count;
 	uint32_t quat_tdm_clk_count;
+	struct snd_soc_jack_gpio earjack_gpios[2];
+	int num_earjack_gpios;
 };
 
+/*
+ * SM-T545 GPIO jack: the media key line reads active without a plug (it is not driven), so the button is only reported while a plug is in,
+ * and a removal releases it.
+ */
+static int sdm845_earjack_det_check(void *data)
+{
+	struct sdm845_snd_data *pdata = data;
+	bool plug = gpiod_get_value_cansleep(pdata->earjack_gpios[0].desc);
+
+	if (!plug)
+		snd_soc_jack_report(&pdata->jack, 0, SND_JACK_BTN_0);
+	return plug ? SND_JACK_HEADPHONE : 0;
+}
+
+static int sdm845_earjack_key_check(void *data)
+{
+	struct sdm845_snd_data *pdata = data;
