 sound/soc/codecs/msm8916-wcd-digital.c |  91 +++++++++++++--
 sound/soc/qcom/sdm845.c                | 148 ++++++++++++++++++++++++-
 3 files changed, 351 insertions(+), 19 deletions(-)

