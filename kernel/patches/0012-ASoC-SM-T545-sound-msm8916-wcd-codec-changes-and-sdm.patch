+static int pm8916_wcd_analog_enable_ncp_clk(struct snd_soc_dapm_widget *w,
+					    struct snd_kcontrol *kcontrol,
+					    int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct pm8916_wcd_analog_priv *priv = dev_get_drvdata(component->dev);
+
+	/* the vendor driver never sets NCP_CLK_EN on DIANGU/DRAX (it only sets the PDM clock bit), so leave it alone */
+	if (priv->pm660l)
+		return 0;
+
+	snd_soc_component_update_bits(component, CDC_D_CDC_DIG_CLK_CTL,
+				      DIG_CLK_CTL_NCP_CLK_EN_MASK,
+				      event == SND_SOC_DAPM_PRE_PMU ? DIG_CLK_CTL_NCP_CLK_EN : 0);
+	return 0;
+}
+
+static int pm8916_wcd_analog_enable_hph_dac(struct snd_soc_dapm_widget *w,
+					    struct snd_kcontrol *kcontrol,
+					    int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct pm8916_wcd_analog_priv *priv = dev_get_drvdata(component->dev);
+
+	if (!priv->pm660l)
+		return 0;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		/* vendor: 2 ms against a wrong PA state after a quick HPH disable/enable */
+		usleep_range(2000, 2100);
+		if (w->reg == CDC_A_RX_HPH_L_PA_DAC_CTL) {
+			/* vendor (> CAJON): pulse CNP_EN bit 3 before the left DAC comes up */
+			snd_soc_component_update_bits(component, CDC_A_RX_HPH_CNP_EN, BIT(3), BIT(3));
+			snd_soc_component_update_bits(component, CDC_A_RX_HPH_CNP_EN, BIT(3), 0);
+		}
+		/* hold the DAC data path in reset while the DAC (bit 3, written by DAPM next) powers up */
+		snd_soc_component_update_bits(component, w->reg, RX_HPH_R_PA_DAC_CTL_DATA_RESET_MASK,
+					      RX_HPH_R_PA_DAC_CTL_DATA_RESET);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		snd_soc_component_update_bits(component, w->reg, RX_HPH_R_PA_DAC_CTL_DATA_RESET_MASK, 0);
+		break;
+	}
+	return 0;
+}
