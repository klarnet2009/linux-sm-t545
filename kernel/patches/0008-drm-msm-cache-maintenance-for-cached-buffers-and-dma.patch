index a4cf31853..9f299bc56 100644
--- a/drivers/gpu/drm/msm/msm_gem.h
+++ b/drivers/gpu/drm/msm/msm_gem.h
@@ -296,6 +296,7 @@ int msm_gem_madvise(struct drm_gem_object *obj, unsigned madv);
 bool msm_gem_active(struct drm_gem_object *obj);
 int msm_gem_cpu_prep(struct drm_gem_object *obj, uint32_t op, ktime_t *timeout);
 int msm_gem_cpu_fini(struct drm_gem_object *obj);
+void msm_gem_cpu_sync(struct drm_gem_object *obj);
 int msm_gem_new_handle(struct drm_device *dev, struct drm_file *file,
 		size_t size, uint32_t flags, uint32_t *handle, char *name);
 struct drm_gem_object *msm_gem_new(struct drm_device *dev,
diff --git a/drivers/gpu/drm/msm/msm_gem_prime.c b/drivers/gpu/drm/msm/msm_gem_prime.c
index 036d34c67..5f4bb99e5 100644
--- a/drivers/gpu/drm/msm/msm_gem_prime.c
+++ b/drivers/gpu/drm/msm/msm_gem_prime.c
@@ -51,7 +51,22 @@ static void msm_gem_dmabuf_release(struct dma_buf *dma_buf)
 	drm_gem_dmabuf_release(dma_buf);
 }
 
+/* t545: DMA_BUF_IOCTL_SYNC from importers that mmap the dma-buf (camera, codec HALs): cache maintenance */
+static int msm_gem_dmabuf_begin_cpu_access(struct dma_buf *dma_buf, enum dma_data_direction dir)
+{
+	msm_gem_cpu_sync(dma_buf->priv);
+	return 0;
+}
+
+static int msm_gem_dmabuf_end_cpu_access(struct dma_buf *dma_buf, enum dma_data_direction dir)
+{
+	msm_gem_cpu_sync(dma_buf->priv);
+	return 0;
+}
+
 static const struct dma_buf_ops msm_gem_prime_dmabuf_ops =  {
+	.begin_cpu_access = msm_gem_dmabuf_begin_cpu_access,
+	.end_cpu_access = msm_gem_dmabuf_end_cpu_access,
 	.attach = drm_gem_map_attach,
 	.detach = drm_gem_map_detach,
 	.map_dma_buf = drm_gem_map_dma_buf,
