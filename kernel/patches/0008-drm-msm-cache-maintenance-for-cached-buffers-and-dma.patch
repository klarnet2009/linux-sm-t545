From 6a5cd05f49e732dc68d83716d6367205f1cb90e5 Mon Sep 17 00:00:00 2001
From: klarnet2009 <185848556+klarnet2009@users.noreply.github.com>
Date: Wed, 28 Oct 2026 10:17:52 +0200
Subject: [PATCH 08/14] drm/msm: cache maintenance for cached buffers and
 dma-buf CPU access; DPU video prefill

The GPU, display, camera and video DMA are not coherent on this SoC: clean and invalidate MSM_BO_CACHED objects around CPU access, implement begin/end_cpu_access for importers that mmap the dma-buf, and start video frames as early as the front porch allows (24 lines of prefill underrun while recording). Adds the Himax HX8279 panel driver of the SM-T545.
---
 .../drm/msm/disp/dpu1/dpu_encoder_phys_vid.c  |   3 +-
 drivers/gpu/drm/msm/msm_gem.c                 |  25 +-
 drivers/gpu/drm/msm/msm_gem.h                 |   1 +
 drivers/gpu/drm/msm/msm_gem_prime.c           |  15 +
 drivers/gpu/drm/panel/Kconfig                 |   8 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 drivers/gpu/drm/panel/panel-t545-hx8279.c     | 545 ++++++++++++++++++
 7 files changed, 595 insertions(+), 3 deletions(-)
 create mode 100644 drivers/gpu/drm/panel/panel-t545-hx8279.c

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
index 0ba777bda..feb9c4014 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -196,7 +196,8 @@ static u32 programmable_fetch_get_num_lines(
 		actual_vfp_lines = timing->v_front_porch;
 	} else {
 		DPU_DEBUG_VIDENC(phys_enc, "room in vfp for needed prefetch\n");
-		actual_vfp_lines = needed_vfp_lines;
+		/* t545: as early as the VFP allows; 24 lines of prefill underrun at frame start while video is recorded */
+		actual_vfp_lines = timing->v_front_porch - 1;
 	}
 
 	DPU_DEBUG_VIDENC(phys_enc,
diff --git a/drivers/gpu/drm/msm/msm_gem.c b/drivers/gpu/drm/msm/msm_gem.c
index 017411a0b..723648970 100644
--- a/drivers/gpu/drm/msm/msm_gem.c
+++ b/drivers/gpu/drm/msm/msm_gem.c
@@ -141,6 +141,25 @@ static void sync_for_cpu(struct msm_gem_object *msm_obj)
 	dma_unmap_sgtable(dev, msm_obj->sgt, DMA_BIDIRECTIONAL, 0);
 }
 
+/*
+ * t545: MSM_BO_CACHED objects are CPU cached on a SoC whose GPU, display, camera and video DMA are not coherent:
+ * clean + invalidate their pages around CPU access (map = clean, unmap = invalidate, as above).
+ */
+static void sync_cached_locked(struct msm_gem_object *msm_obj)
+{
+	if ((msm_obj->flags & MSM_BO_CACHE_MASK) != MSM_BO_CACHED || !msm_obj->sgt)
+		return;
+	sync_for_device(msm_obj);
+	sync_for_cpu(msm_obj);
+}
+
+void msm_gem_cpu_sync(struct drm_gem_object *obj)
+{
+	msm_gem_lock(obj);
+	sync_cached_locked(to_msm_bo(obj));
+	msm_gem_unlock(obj);
+}
+
 static void update_lru_active(struct drm_gem_object *obj)
 {
 	struct msm_drm_private *priv = obj->dev->dev_private;
@@ -221,6 +240,8 @@ static struct page **get_pages(struct drm_gem_object *obj)
 		 */
 		if (msm_obj->flags & MSM_BO_WC)
 			sync_for_device(msm_obj);
+		/* t545: also the zeroed pages of cached objects, their dirty lines would land on device data later */
+		sync_cached_locked(msm_obj);
 
 		update_lru(obj);
 	}
@@ -964,14 +985,14 @@ int msm_gem_cpu_prep(struct drm_gem_object *obj, uint32_t op, ktime_t *timeout)
 	else if (ret < 0)
 		return ret;
 
-	/* TODO cache maintenance */
+	msm_gem_cpu_sync(obj);
 
 	return 0;
 }
 
 int msm_gem_cpu_fini(struct drm_gem_object *obj)
 {
-	/* TODO cache maintenance */
+	msm_gem_cpu_sync(obj);
 	return 0;
 }
 
