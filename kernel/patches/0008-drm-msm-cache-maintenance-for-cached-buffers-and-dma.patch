+
+struct t545_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator *supply;
+	struct gpio_desc *reset;
+	struct gpio_desc *isl_en;
+	bool prepared;
+	bool page4;	/* the HX8279 still has register page 4 (backlight PWM) selected */
+};
+
+static inline struct t545_panel *to_t545(struct drm_panel *p)
+{
+	return container_of(p, struct t545_panel, panel);
+}
+
+static const struct drm_display_mode t545_mode = {
+	.clock = 159897,
+	.hdisplay = 1200,
+	.hsync_start = 1200 + 111,
+	.hsync_end = 1200 + 111 + 10,
+	.htotal = 1200 + 111 + 10 + 40,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 16,
+	.vsync_end = 1920 + 16 + 4,
+	.vtotal = 1920 + 16 + 4 + 18,
+	.width_mm = 135,
+	.height_mm = 216,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int t545_send_init(struct t545_panel *p)
+{
+	struct mipi_dsi_device *dsi = p->dsi;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(t545_init); i++) {
+		const struct t545_cmd *c = &t545_init[i];
+
+		ret = mipi_dsi_dcs_write_buffer(dsi, c->data, c->len);
+		if (ret < 0) {
+			dev_err(&dsi->dev, "init command %d failed: %d\n", i, ret);
+			return ret;
+		}
+		if (c->wait_ms)
+			msleep(c->wait_ms);
+	}
+	return 0;
+}
+
+static int t545_prepare(struct drm_panel *panel)
+{
+	struct t545_panel *p = to_t545(panel);
+
+	p->page4 = false;	/* the init sequence selects other pages */
+	struct device *dev = &p->dsi->dev;
+	int ret;
+
+	if (p->prepared)
+		return 0;
+
+	ret = regulator_enable(p->supply);
+	if (ret) {
+		dev_err(dev, "tft-vdd enable failed: %d\n", ret);
+		return ret;
+	}
+	msleep(7);
+	gpiod_set_value_cansleep(p->isl_en, 1);	/* ISL98608 AVDD/AVEE */
+	msleep(10);
+
+	gpiod_set_value_cansleep(p->reset, 1);
+	msleep(10);
+	gpiod_set_value_cansleep(p->reset, 0);
+	msleep(20);
+
+	p->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = t545_send_init(p);
+	if (ret)
+		goto err;
+
+	ret = mipi_dsi_dcs_exit_sleep_mode(p->dsi);
+	if (ret)
+		goto err;
+	msleep(120);
+
+	ret = mipi_dsi_dcs_set_display_on(p->dsi);
+	if (ret)
+		goto err;
+	msleep(20);
+
+	p->prepared = true;
+	return 0;
+err:
+	gpiod_set_value_cansleep(p->reset, 1);
+	gpiod_set_value_cansleep(p->isl_en, 0);
+	regulator_disable(p->supply);
+	return ret;
+}
+
+static int t545_unprepare(struct drm_panel *panel)
+{
+	struct t545_panel *p = to_t545(panel);
+
+	if (!p->prepared)
+		return 0;
+
+	mipi_dsi_dcs_set_display_off(p->dsi);
+	mipi_dsi_dcs_enter_sleep_mode(p->dsi);
+	msleep(120);
+	gpiod_set_value_cansleep(p->reset, 1);
+	gpiod_set_value_cansleep(p->isl_en, 0);
+	msleep(2);
+	regulator_disable(p->supply);
+	p->prepared = false;
+	return 0;
+}
+
+static int t545_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &t545_mode);
+}
+
+static const struct drm_panel_funcs t545_funcs = {
+	.prepare = t545_prepare,
+	.unprepare = t545_unprepare,
+	.get_modes = t545_get_modes,
+};
+
+static int t545_bl_update(struct backlight_device *bl)
+{
+	/* the stock driver controls the backlight PWM of the HX8279 with page 4, register 0xb8 */
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct t545_panel *p = mipi_dsi_get_drvdata(dsi);
+	const u8 page4[] = { 0xb0, 0x04 };
+	u8 pwm[] = { 0xb8, backlight_get_brightness(bl) };
+	int ret = 0;
+
+	/*
+	 * Each DCS command costs ~33 ms in video mode: select page 4 only once after the init sequence, so that a brightness
+	 * change is one command (the framework animates the slider; two commands per step made it visibly stepped).
+	 */
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	if (!p->page4) {
+		ret = mipi_dsi_dcs_write_buffer(dsi, page4, sizeof(page4));
+		p->page4 = ret >= 0;
+	}
+	if (ret >= 0)
+		ret = mipi_dsi_dcs_write_buffer(dsi, pwm, sizeof(pwm));
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	return ret < 0 ? ret : 0;
+}
+
+static const struct backlight_ops t545_bl_ops = {
+	.update_status = t545_bl_update,
+};
+
+static int t545_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 160,
+		.max_brightness = 255,
+	};
+	struct backlight_device *bl;
+	struct t545_panel *p;
+	int ret;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	p->supply = devm_regulator_get(dev, "power");
+	if (IS_ERR(p->supply))
+		return dev_err_probe(dev, PTR_ERR(p->supply), "power supply\n");
+	p->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(p->reset))
+		return dev_err_probe(dev, PTR_ERR(p->reset), "reset gpio\n");
+	p->isl_en = devm_gpiod_get(dev, "isl-enable", GPIOD_OUT_LOW);
+	if (IS_ERR(p->isl_en))
+		return dev_err_probe(dev, PTR_ERR(p->isl_en), "isl-enable gpio\n");
+
+	p->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, p);
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_LPM;
+
+	drm_panel_init(&p->panel, dev, &t545_funcs, DRM_MODE_CONNECTOR_DSI);
+	p->panel.prepare_prev_first = true;	/* the init commands need the DSI link up */
+	/* "panel": the stock lights HAL (vendor.samsung.hardware.light-service) writes /sys/class/backlight/panel/brightness */
+	bl = devm_backlight_device_register(dev, "panel", dev, dsi, &t545_bl_ops, &props);
+	if (IS_ERR(bl))
+		return PTR_ERR(bl);
+	p->panel.backlight = bl;
+	drm_panel_add(&p->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&p->panel);
+		return dev_err_probe(dev, ret, "dsi attach\n");
+	}
+	return 0;
+}
+
+static void t545_remove(struct mipi_dsi_device *dsi)
+{
+	struct t545_panel *p = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&p->panel);
+}
+
+static const struct of_device_id t545_of_match[] = {
+	{ .compatible = "samsung,sm-t545-hx8279" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, t545_of_match);
+
+static struct mipi_dsi_driver t545_driver = {
+	.probe = t545_probe,
+	.remove = t545_remove,
+	.driver = {
+		.name = "panel-t545-hx8279",
+		.of_match_table = t545_of_match,
+	},
+};
+module_mipi_dsi_driver(t545_driver);
+
+MODULE_DESCRIPTION("SM-T545 BOE TV101WUM (Himax HX8279) panel driver");
+MODULE_LICENSE("GPL");
