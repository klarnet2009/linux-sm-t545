+++ b/drivers/input/touchscreen/Kconfig
@@ -1250,6 +1250,18 @@ config TOUCHSCREEN_ST1232
 	  To compile this driver as a module, choose M here: the
 	  module will be called st1232_ts.
 
+config TOUCHSCREEN_FTS1BA90_T545
+	tristate "STMicroelectronics FTS1BA90 touchscreen of the SM-T545"
+	depends on I2C
+	help
+	  Touch controller of the Samsung Galaxy Tab Active Pro LTE.
+
+config TOUCHSCREEN_WACOM_W9019_T545
+	tristate "Wacom W9019 pen digitizer of the SM-T545"
+	depends on I2C
+	help
+	  Pen digitizer of the Samsung Galaxy Tab Active Pro LTE.
+
 config TOUCHSCREEN_STMFTS
 	tristate "STMicroelectronics STMFTS touchscreen"
 	depends on I2C
