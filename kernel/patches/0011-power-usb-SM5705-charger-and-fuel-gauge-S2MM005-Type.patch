diff --git a/drivers/usb/typec/s2mm005-t545.c b/drivers/usb/typec/s2mm005-t545.c
new file mode 100644
index 000000000..c56fd2191
--- /dev/null
+++ b/drivers/usb/typec/s2mm005-t545.c
@@ -0,0 +1,380 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S2MM005 USB Type-C / PD controller of the SM-T545 (Galaxy Tab Active Pro), minimal mainline driver.
+ *
+ * The S2MM005 runs its own flash firmware: CC detection, DRP toggling and the PD negotiation happen inside the chip, which
+ * raises its interrupt (tlmm gpio38, falling edge) and leaves the state in SRAM read over I2C (16-bit big-endian address,
+ * little-endian words). Like Samsung's drivers/ccic/s2mm005_cc.c process_cc_attach() this driver only follows the attach:
+ *  - the chip is the source (partner = sink, e.g. a USB stick): VBUS on (connector "vbus-supply" = the SM5705 OTG boost),
+ *    then the DWC3 role switch to host;
+ *  - the chip is the sink (PC, charger): role device;
+ *  - detach: VBUS off, role none (DWC3 goes back to its default role, peripheral).
+ * No role swaps, no alternate modes, no firmware update. Fast charging (PDO select) stays in sm5705-chg-t545, which talks to
+ * the same chip through this client. Source of every register: Samsung 4.9 tree, file:line.
+ */
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/property.h>
+#include <linux/regulator/consumer.h>
+#include <linux/usb/role.h>
+#include <linux/usb/typec.h>
+
+#define REG_DUMMY		0x0008	/* read first, wakes the controller (s2mm005_cc.c:691-694) */
+#define REG_CMD			0x0010	/* I2C_SLV_CMD (include/linux/ccic/s2mm005.h:46) */
+#define REG_FUNC_STATE		0x0020	/* s2mm005.h:176-198 */
+#define REG_INT_STATUS		0x0030	/* 48 bytes, read before the clear (s2mm005_cc.c:1142-1166) */
+#define REG_LP_STATE		0x0060	/* s2mm005.h:203-219 */
+
+#define CMD_INT_CLEAR		0x01	/* s2mm005_int_clear (s2mm005.c:275-280) */
+#define CMD_MANUAL_LPM		0x0f	/* + mode byte (s2mm005_manual_LPM, s2mm005.c:428-449) */
+#define LPM_AUTO_ENABLE		0x06	/* after a controller reset (s2mm005_cc.c:807-813) */
+#define LPM_SLEEP_CABLE		0x0d	/* s2mm005_cc.c:815-818 */
+
+#define FS_PD_STATE		GENMASK(7, 0)
+#define FS_ATTACH_DONE		BIT(24)
+#define FS_IS_SOURCE		BIT(25)
+#define FS_IS_DFP		BIT(26)
+#define FS_RP_LVL		GENMASK(28, 27)	/* 1 = 56k (default USB), 2 = 22k (1.5 A), 3 = 10k (3 A) (s2mm005.h:800-804) */
+#define FS_RESET		BIT(31)
+#define LP_AUTO_LP		BIT(0)
+#define LP_WATER		BIT(3)
+#define LP_RUN_DRY		BIT(5)
+#define LP_SLEEP_CABLE		BIT(8)
+
+/* policy engine states (s2mm005.h:733-772) */
+#define PE_DETACHED		0
+#define PE_SRC_SEND_CAPS	3
+#define PE_SRC_DISABLED		7
+#define PE_SRC_READY		6
+#define PE_SRC_WAIT_NEW_CAPS	14
+#define PE_SNK_WAIT_CAPS	17
+#define PE_SNK_EVAL_CAPS	18
+#define PE_SNK_READY		21
+#define PE_ERROR_RECOVERY	29
+
+static bool ignore_moisture;
+module_param(ignore_moisture, bool, 0644);
+MODULE_PARM_DESC(ignore_moisture, "follow the attach even when the controller reports water or not RUN_DRY (bring-up only)");
+
+struct s2mm005 {
+	struct i2c_client *client;
+	struct mutex lock;		/* IRQ thread and probe */
+	struct typec_port *port;
+	struct typec_partner *partner;
+	struct usb_role_switch *role_sw;
+	struct regulator *vbus;		/* NULL: no VBUS control */
+	struct fwnode_handle *connector;
+	enum usb_role role;
+	bool vbus_on;
+	bool water;
+};
+
+static int s2mm_read(struct s2mm005 *s, u16 reg, void *buf, u16 len)
+{
+	u8 addr[2] = { reg >> 8, reg & 0xff };
+	struct i2c_msg msg[2] = {
+		{ .addr = s->client->addr, .len = 2, .buf = addr },
+		{ .addr = s->client->addr, .flags = I2C_M_RD, .len = len, .buf = buf },
+	};
+	int ret = i2c_transfer(s->client->adapter, msg, 2);
+
+	return ret == 2 ? 0 : ret < 0 ? ret : -EIO;
+}
+
+static int s2mm_cmd(struct s2mm005 *s, const u8 *cmd, int len)
+{
+	u8 buf[4] = { REG_CMD >> 8, REG_CMD & 0xff };
+	int ret;
+
+	memcpy(&buf[2], cmd, len);
+	ret = i2c_master_send(s->client, buf, len + 2);
+	return ret == len + 2 ? 0 : ret < 0 ? ret : -EIO;
+}
+
+static void s2mm_lpm(struct s2mm005 *s, u8 mode)
+{
+	u8 cmd[] = { CMD_MANUAL_LPM, mode };
+	u8 dummy;
+	int i;
+
+	for (i = 0; i < 5; i++)		/* the stock wakes the controller with five dummy reads first */
+		s2mm_read(s, REG_DUMMY, &dummy, 1);
+	udelay(10);
+	if (s2mm_cmd(s, cmd, sizeof(cmd)))
+		dev_warn(&s->client->dev, "manual LPM %#x failed\n", mode);
+}
+
+static void s2mm_vbus(struct s2mm005 *s, bool on)
+{
+	int ret;
+
+	if (!s->vbus || s->vbus_on == on)
+		return;
+	ret = on ? regulator_enable(s->vbus) : regulator_disable(s->vbus);
+	if (ret) {
+		/* e.g. -EBUSY: someone else already drives VBUS; the host role still works then */
+		dev_warn(&s->client->dev, "VBUS %s failed: %d\n", on ? "on" : "off", ret);
+		return;
+	}
+	s->vbus_on = on;
+}
+
+static void s2mm_partner(struct s2mm005 *s, bool attached, bool pd)
+{
+	struct typec_partner_desc desc = { .usb_pd = pd, .accessory = TYPEC_ACCESSORY_NONE };
+
+	if (attached && !s->partner) {
+		s->partner = typec_register_partner(s->port, &desc);
+		if (IS_ERR(s->partner)) {
+			dev_warn(&s->client->dev, "partner not registered: %pe\n", s->partner);
+			s->partner = NULL;
+		}
+	} else if (!attached && s->partner) {
+		typec_unregister_partner(s->partner);
+		s->partner = NULL;
+	}
+}
+
+/* the order of process_cc_attach (s2mm005_cc.c:836-1000): old role down, 300 ms, VBUS, new role */
+static void s2mm_set_role(struct s2mm005 *s, enum usb_role role, u32 fs)
+{
+	int pd_state = FIELD_GET(FS_PD_STATE, fs);
+	bool pd = pd_state == PE_SRC_READY || pd_state == PE_SNK_READY;
+
+	if (role == s->role) {
+		if (role != USB_ROLE_NONE && pd)
+			typec_set_pwr_opmode(s->port, TYPEC_PWR_MODE_PD);
+		return;
+	}
+	dev_info(&s->client->dev, "%s -> %s (PD state %d, func state %08x)\n", usb_role_string(s->role), usb_role_string(role),
+		 pd_state, fs);
+	if (s->role != USB_ROLE_NONE && role != USB_ROLE_NONE) {
+		/* source <-> sink without a detach: drop the old role first like the stock */
+		usb_role_switch_set_role(s->role_sw, USB_ROLE_NONE);
+		s2mm_vbus(s, false);
+		msleep(300);
+	}
+	switch (role) {
+	case USB_ROLE_HOST:
+		s2mm_partner(s, true, pd);
+		typec_set_pwr_role(s->port, TYPEC_SOURCE);
+		typec_set_data_role(s->port, TYPEC_HOST);
+		typec_set_pwr_opmode(s->port, pd ? TYPEC_PWR_MODE_PD : TYPEC_PWR_MODE_USB);
+		s2mm_vbus(s, true);
+		break;
+	case USB_ROLE_DEVICE:
+		s2mm_vbus(s, false);
+		s2mm_partner(s, true, pd);
+		typec_set_pwr_role(s->port, TYPEC_SINK);
+		typec_set_data_role(s->port, TYPEC_DEVICE);
+		typec_set_pwr_opmode(s->port, pd ? TYPEC_PWR_MODE_PD :
+				     FIELD_GET(FS_RP_LVL, fs) == 3 ? TYPEC_PWR_MODE_3_0A :
+				     FIELD_GET(FS_RP_LVL, fs) == 2 ? TYPEC_PWR_MODE_1_5A : TYPEC_PWR_MODE_USB);
+		break;
+	default:
+		s2mm_vbus(s, false);
+		s2mm_partner(s, false, false);
+		typec_set_pwr_role(s->port, TYPEC_SINK);
+		typec_set_data_role(s->port, TYPEC_DEVICE);
+		typec_set_pwr_opmode(s->port, TYPEC_PWR_MODE_USB);
+		break;
+	}
+	usb_role_switch_set_role(s->role_sw, role);
+	s->role = role;
+}
+
+static void s2mm_update(struct s2mm005 *s)
+{
+	struct device *dev = &s->client->dev;
+	__le32 w;
+	u32 fs, lp;
+	u8 dummy;
+	int pd_state;
+
+	s2mm_read(s, REG_DUMMY, &dummy, 1);
+	if (s2mm_read(s, REG_LP_STATE, &w, 4))
+		return;
+	lp = le32_to_cpu(w);
+	if (s2mm_read(s, REG_FUNC_STATE, &w, 4))
+		return;
+	fs = le32_to_cpu(w);
+	pd_state = FIELD_GET(FS_PD_STATE, fs);
+	dev_dbg(dev, "func state %08x lp state %08x\n", fs, lp);
+
+	/* moisture: the stock handles attach only while dry (s2mm005_cc.c:760-776); no VBUS into a wet port */
+	if (((lp & LP_WATER) || !(lp & LP_RUN_DRY)) && !ignore_moisture) {
+		if (!s->water)
+			dev_warn(dev, "moisture reported (lp state %08x): port off\n", lp);
+		s->water = true;
+		s2mm_set_role(s, USB_ROLE_NONE, fs);
+		return;
+	}
+	if (s->water)
+		dev_info(dev, "port dry again\n");
+	s->water = false;
+
+	if ((fs & FS_RESET) && !(lp & LP_AUTO_LP)) {
+		dev_info(dev, "controller reset seen, auto LPM on\n");
+		s2mm_lpm(s, LPM_AUTO_ENABLE);
+	}
+	if (pd_state == PE_SRC_WAIT_NEW_CAPS && (lp & LP_SLEEP_CABLE)) {
+		s2mm_lpm(s, LPM_SLEEP_CABLE);
+		return;
+	}
+
+	switch (pd_state) {
+	case PE_DETACHED:
+		s2mm_set_role(s, USB_ROLE_NONE, fs);
+		break;
+	case PE_SRC_SEND_CAPS ... PE_SRC_DISABLED:
+		s2mm_set_role(s, USB_ROLE_HOST, fs);
+		break;
+	case PE_SNK_WAIT_CAPS:
+	case PE_SNK_EVAL_CAPS:
+	case PE_SNK_READY:
+	case PE_ERROR_RECOVERY:
+		s2mm_set_role(s, USB_ROLE_DEVICE, fs);
+		break;
+	default:	/* transitional states: keep the role until a stable one shows up */
+		break;
+	}
+}
+
+static void s2mm_event(struct s2mm005 *s)
+{
+	u8 st[48];
+	u8 clear = CMD_INT_CLEAR;
+
+	guard(mutex)(&s->lock);
+	s2mm_update(s);
+	if (!s2mm_read(s, REG_INT_STATUS, st, sizeof(st)))
+		dev_dbg(&s->client->dev, "msg irq %*phN\n", 4, &st[16]);
+	if (s2mm_cmd(s, &clear, 1))
+		dev_warn(&s->client->dev, "interrupt clear failed\n");
+	/* a change between the state read and the clear raised no edge of its own */
+	s2mm_update(s);
+}
+
+static irqreturn_t s2mm_irq(int irq, void *data)
+{
+	s2mm_event(data);
+	return IRQ_HANDLED;
+}
+
+static int s2mm_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct typec_capability cap = { };
+	struct s2mm005 *s;
+	int ret;
+
+	if (!client->irq)
+		return dev_err_probe(dev, -EINVAL, "no interrupt\n");
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	s->client = client;
+	s->role = USB_ROLE_NONE;
+	i2c_set_clientdata(client, s);
+	ret = devm_mutex_init(dev, &s->lock);
+	if (ret)
+		return ret;
+
+	s->connector = device_get_named_child_node(dev, "connector");
+	if (!s->connector)
+		return dev_err_probe(dev, -ENODEV, "no connector node\n");
+	s->role_sw = fwnode_usb_role_switch_get(s->connector);
+	if (IS_ERR(s->role_sw)) {
+		ret = dev_err_probe(dev, PTR_ERR(s->role_sw), "role switch\n");
+		goto err_fwnode;
+	}
+	s->vbus = devm_of_regulator_get_optional(dev, to_of_node(s->connector), "vbus");
+	if (IS_ERR(s->vbus)) {
+		ret = PTR_ERR(s->vbus);
+		if (ret != -ENODEV) {
+			dev_err_probe(dev, ret, "vbus supply\n");
+			goto err_role;
+		}
+		dev_warn(dev, "no vbus-supply: host role without VBUS\n");
+		s->vbus = NULL;
+	}
+
+	ret = typec_get_fw_cap(&cap, s->connector);
+	if (ret) {
+		dev_err_probe(dev, ret, "connector properties\n");
+		goto err_role;
+	}
+	cap.revision = USB_TYPEC_REV_1_2;	/* as the stock typec_cap (s2mm005.c:1117-1119) */
+	cap.pd_revision = 0x300;
+	cap.driver_data = s;
+	s->port = typec_register_port(dev, &cap);
+	if (IS_ERR(s->port)) {
+		ret = dev_err_probe(dev, PTR_ERR(s->port), "typec port\n");
+		goto err_role;
+	}
+
+	/* stock probe: IRQ first, then one pass over the current state (s2mm005.c:1170-1216, TEMP_CODE path) */
+	ret = request_threaded_irq(client->irq, NULL, s2mm_irq, IRQF_ONESHOT, dev_name(dev), s);
+	if (ret) {
+		dev_err_probe(dev, ret, "irq %d\n", client->irq);
+		goto err_port;
+	}
+	s2mm_event(s);
+	return 0;
+
+err_port:
+	typec_unregister_port(s->port);
+err_role:
+	usb_role_switch_put(s->role_sw);
+err_fwnode:
+	fwnode_handle_put(s->connector);
+	return ret;
+}
+
+static void s2mm_remove(struct i2c_client *client)
+{
+	struct s2mm005 *s = i2c_get_clientdata(client);
+
+	free_irq(client->irq, s);
+	mutex_lock(&s->lock);
+	s2mm_set_role(s, USB_ROLE_NONE, 0);
+	mutex_unlock(&s->lock);
+	typec_unregister_port(s->port);
+	usb_role_switch_put(s->role_sw);
+	fwnode_handle_put(s->connector);
+}
+
+/* no VBUS from the boost across reboot */
+static void s2mm_shutdown(struct i2c_client *client)
+{
+	struct s2mm005 *s = i2c_get_clientdata(client);
+
+	disable_irq(client->irq);
+	guard(mutex)(&s->lock);
+	s2mm_vbus(s, false);
+}
+
+static const struct of_device_id s2mm_of_match[] = {
+	{ .compatible = "samsung,s2mm005" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s2mm_of_match);
+
+static struct i2c_driver s2mm_driver = {
+	.driver = {
+		.name = "s2mm005-t545",
+		.of_match_table = s2mm_of_match,
+	},
+	.probe = s2mm_probe,
+	.remove = s2mm_remove,
+	.shutdown = s2mm_shutdown,
+};
+module_i2c_driver(s2mm_driver);
+
+MODULE_DESCRIPTION("Samsung S2MM005 Type-C controller of the SM-T545 (attach state, data role, VBUS)");
+MODULE_LICENSE("GPL");
