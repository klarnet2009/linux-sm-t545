diff --git a/drivers/usb/gadget/t545-android-usb.c b/drivers/usb/gadget/t545-android-usb.c
new file mode 100644
index 000000000..942172e12
--- /dev/null
+++ b/drivers/usb/gadget/t545-android-usb.c
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Android's UsbService creates its UsbDeviceManager (USB modes in Settings, the adb authorisation flow, "USB debugging connected")
+ * only when /sys/class/android_usb exists. The Android common kernel creates that class from its configfs gadget hooks; mainline has
+ * none, so Settings > USB crashed in UsbManager.getCurrentFunctions ("USB device mode not supported"). Stand-in: class android_usb
+ * with device android0 (DEVPATH /devices/virtual/android_usb/android0, the path UsbDeviceManager's uevent observer matches).
+ * shortcut: "state" is always CONFIGURED and no state uevents are sent; hook the composite driver's connect/disconnect when the
+ * USB notification and charging-only mode have to follow the cable.
+ */
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/kdev_t.h>
+#include <linux/sysfs.h>
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "CONFIGURED\n");
+}
+static DEVICE_ATTR_RO(state);
+
+static struct attribute *android_usb_attrs[] = {
+	&dev_attr_state.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(android_usb);
+
+static const struct class android_usb_class = {
+	.name = "android_usb",
+};
+
+static int __init t545_android_usb_init(void)
+{
+	struct device *dev;
+	int ret;
+
+	ret = class_register(&android_usb_class);
+	if (ret)
+		return ret;
+	dev = device_create_with_groups(&android_usb_class, NULL, MKDEV(0, 0), NULL, android_usb_groups, "android0");
+	if (IS_ERR(dev)) {
+		class_unregister(&android_usb_class);
+		return PTR_ERR(dev);
+	}
+	return 0;
+}
+late_initcall(t545_android_usb_init);
